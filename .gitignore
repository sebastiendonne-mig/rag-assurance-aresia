# Secrets — ne jamais committer
.env*
!.env.example
.streamlit/secrets.toml

# Index Chroma — reconstruit au build Docker depuis data/chunks/chunks.json
# (voir Dockerfile), plus une copie locale de dev ne doit partir en prod
chroma_db/

# Environnement Python local
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Logs de debug Streamlit
data/*.log

# Résultats d'évaluation : tout tests/results/ est ignoré (golden set, caches,
# runs de fumée…), sauf les résultats de référence du sous-lot 3.2 (run complet
# du 25/09/2026, base du juge LLM) et les résultats du juge LLM (jugements,
# comparaison juge / humain).
tests/results/*
!tests/results/upload_eval_20260925_104952.json
!tests/results/upload_eval_20260925_104952.md
!tests/results/judge_upload_*
!tests/results/judge_compare_*

# Artefacts macOS
.DS_Store

